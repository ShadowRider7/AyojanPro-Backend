model Payment {
  id         String @id @default(uuid())
  contractId String
  clientId String

  stage  PaymentStage
  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(BKASH)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("BDT") @db.VarChar(10)

  bkashPaymentId        String? @unique @db.VarChar(255)
  bkashTransactionId    String? @unique @db.VarChar(255)
  payerReference        String? @db.VarChar(255)
  merchantInvoiceNumber String? @unique @db.VarChar(255)

  transactionTime DateTime?
  paidAt          DateTime?

  // Set when the money is released from the platform escrow to the
  // professional — that happens when the contract is completed.
  releasedAt DateTime?

  // Set when a cancelled contract is refunded back to the client.
  refundedAt      DateTime?
  refundAmount    Decimal? @db.Decimal(12, 2)
  refundReason    String? @db.Text
  refundReference String? @db.VarChar(255)

  failureReason String? @db.Text
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId],references: [id])
  refund Refund?

  @@unique([contractId])
  @@index([status])
  @@index([bkashPaymentId])
  @@index([bkashTransactionId])
}
